{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc", "import"],
	"categories": {
		"correctness": "error",
		"suspicious": "warn"
	},
	"env": {
		"builtin": true,
		"browser": true,
		"node": true
	},
	"rules": {
		"import/no-unassigned-import": [
			"warn",
			{
				"allow": ["**/*.css"]
			}
		]
	},
	"overrides": [
		{
			"files": ["**/*.d.ts"],
			"rules": {
				"unicorn/require-module-specifiers": "off"
			}
		}
	]
}
