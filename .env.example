# SQLite by default. For Postgres run `pnpm db:start` and use:
# DATABASE_URL="postgres://eazyid:eazyid@localhost:5432/eazyid"
DATABASE_URL="file:./data/eazyid.db"

ORIGIN="http://localhost:5173"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Max request body for the production server (adapter-node). Login image uploads need up to 2 MB.
BODY_SIZE_LIMIT="4M"
