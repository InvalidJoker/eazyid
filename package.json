{
	"name": "ezid-v2",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxlint && oxfmt --check",
		"format": "oxfmt",
		"db:start": "docker compose up -d",
		"auth:schema": "auth generate --config src/lib/server/auth/index.ts --adapter drizzle --dialect postgresql --output src/lib/server/db/postgres/auth.schema.ts --yes && auth generate --config src/lib/server/auth/index.ts --adapter drizzle --dialect sqlite --output src/lib/server/db/sqlite/auth.schema.ts --yes && oxfmt src/lib/server/db",
		"db:generate": "drizzle-kit generate --config drizzle/postgres.config.ts && drizzle-kit generate --config drizzle/sqlite.config.ts"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.62.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22",
		"auth": "^1.6.24",
		"better-auth": "^1.6.24",
		"bits-ui": "^2.20.2",
		"cn": "^0.5.0",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"postgres": "^3.4.9",
		"shadcn-svelte": "^1.7.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@libsql/client": "^0.18.0",
		"@orpc/client": "^1.16.1",
		"@orpc/server": "^1.16.1",
		"zod": "^4.6.7"
	}
}
